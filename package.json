{
  "name": "crypto-ai-trader",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:all": "concurrently -n backend,mobile -c cyan,magenta \"npm run dev\" \"npm run mobile:android\"",
    "mobile:start": "npm --prefix trading-app run start",
    "mobile:android": "npm --prefix trading-app run android",
    "mobile:ios": "npm --prefix trading-app run ios",
    "mobile:web": "npm --prefix trading-app run web"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.1.0",
    "@stripe/stripe-js": "^9.2.0",
    "api": "^6.1.2",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "expo": "^55.0.15",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "kraken": "^0.4.0",
    "lightweight-charts": "^5.1.0",
    "pg": "^8.16.0",
    "recharts": "^3.8.1",
    "stripe": "^16.12.0",
    "technicalindicators": "^3.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14",
    "typescript": "~5.9.2"
  }
}
