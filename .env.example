# ============= BINANCE API =============
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# ============= INTERNAL AUTHENTICATION =============
INTERNAL_API_KEY=your_internal_api_key_here

# ============= RATE LIMITING =============
# Comment out or leave empty to use in-memory rate limiter (development)
# Set to Redis URL for production
REDIS_URL=redis://localhost:6379

# Optional: Redis with authentication
# REDIS_URL=redis://:password@host:port

# Optional: Redis Cluster (e.g., AWS ElastiCache)
# REDIS_URL=rediss://host:port  # rediss:// for TLS

# ============= ENVIRONMENT =============
NODE_ENV=development
# NODE_ENV=production

# ============= LOGGING =============
LOG_LEVEL=info
# LOG_LEVEL=debug
